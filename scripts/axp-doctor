#!/bin/sh
# axp-doctor - one screen of "why is it not working" for the AirXPi appliance.
set -u

line() { printf '\n== %s\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }

line "system"
printf 'model   : %s\n' "$([ -r /proc/device-tree/model ] && tr -d '\0' < /proc/device-tree/model || echo unknown)"
printf 'kernel  : %s\n' "$(uname -r)"
printf 'uptime  : %s\n' "$(cut -d. -f1 /proc/uptime) s"
printf 'temp    : %s C\n' "$(awk '{printf "%.1f", $1/1000}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo n/a)"

line "services"
for unit in axnet axpanel axplay axgui axtunnel vpnexit-web vpnexit-supervisor hostapd dnsmasq avahi-daemon nqptp shairport-sync; do
    printf '%-20s %s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)"
done
printf '%-20s %s\n' "shairport (axplay)" "$(pgrep -f shairport-sync >/dev/null 2>&1 && echo running || echo stopped)"
printf '%-20s %s\n' "nqptp shm" "$([ -e /dev/shm/nqptp ] && echo present || echo missing)"
printf '%-20s %s\n' "shairport build" "$(shairport-sync -V 2>/dev/null | head -n1 || echo missing)"

line "audio"
if have aplay; then
    aplay -l 2>/dev/null || echo "no playback devices"
else
    echo "alsa-utils missing"
fi
printf 'selected: %s\n' "$(axp-audio show 2>/dev/null || echo unknown)"

line "interfaces"
ip -br -4 addr 2>/dev/null || ip -4 addr

line "uplink"
printf 'default route: %s\n' "$(ip -4 route show default | head -n1)"
printf 'hostapd       : %s\n' "$(systemctl is-active hostapd 2>/dev/null)"
printf 'stations      : %s\n' "$(iw dev wlan0 station dump 2>/dev/null | grep -c '^Station' || echo 0)"

line "access point"
if have hostapd; then
    hostapd -t -c /etc/hostapd/hostapd.conf 2>&1 | tail -n 3
else
    echo "hostapd missing"
fi
iw reg get 2>/dev/null | head -n 5
rfkill list wlan 2>/dev/null | head -n 4
journalctl -u hostapd -b -n 8 --no-pager 2>/dev/null

line "vpn"
/usr/local/sbin/vpnexit status 2>/dev/null | head -c 1200 || echo "vpnexit not installed"
printf '\n'
curl -fsS --max-time 5 http://127.0.0.1:8086/state 2>/dev/null \
    | python3 -c 'import json,sys
s=json.load(sys.stdin)["status"]
print("axtunnel :", s["state"], s.get("protocol") or "-", s.get("device") or "-")
print("exit     :", s.get("exit_ip") or "-", "| routing", s["routing"]["active"])
print("error    :", s.get("error") or "-")' 2>/dev/null || echo "axtunnel not answering on :8086"

line "airplay"
curl -fsS --max-time 5 http://127.0.0.1:8090/api/state 2>/dev/null \
    | python3 -c 'import json,sys
s=json.load(sys.stdin)
print("server   :", s["server"]["running"], "pid", s["server"].get("pid"))
print("device   :", s["config"].get("device"))
print("state    :", s["now_playing"].get("state"))
print("track    :", s["now_playing"].get("title") or "-")
print("displays :", ", ".join(s.get("displays") or []) or "none")
print("meta     :", s.get("metadata_state"))' 2>/dev/null || echo "panel not answering on :8090"

line "recent errors"
journalctl -u axnet -u axpanel -u axplay -u axgui -b -p warning --no-pager 2>/dev/null | tail -n 15
