#!/usr/bin/env python3
"""Align the AirPlay receiver name with the appliance name.

Started by ``axplay.service`` (ExecStartPost) so a fresh image never shows the
upstream default name: /etc/airxpi/airxpi.json is the single source of truth and
the receiver follows it, including the mDNS advertisement.
"""

import json
import sys
import time
import urllib.error
import urllib.request

from airxpi import common as c

API = "http://127.0.0.1:%d" % c.AIRPLAY_PORT


def current_name():
    try:
        with urllib.request.urlopen(API + "/api/state", timeout=3) as response:
            state = json.loads(response.read().decode("utf-8", "replace"))
        return (state.get("config") or {}).get("name", "")
    except (urllib.error.URLError, OSError, ValueError):
        return ""


def rename(name):
    body = json.dumps({"name": name, "force": True}).encode()
    request = urllib.request.Request(API + "/api/config", data=body, method="POST",
                                     headers={"Content-Type": "application/json"})
    try:
        urllib.request.urlopen(request, timeout=30).read()
        return True
    except (urllib.error.URLError, OSError):
        return False


def main():
    name = (c.config()["device"].get("name") or "AirXPi").strip()
    if not name:
        return 0
    for _ in range(20):
        seen = current_name()
        if seen == name:
            return 0
        if seen and rename(name):
            return 0
        time.sleep(1)
    sys.stderr.write("receiver name not applied (panel not reachable)\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
