# AirXPi boot splash - logo centred, progress bar underneath, no text.
# The PNGs are generated by image/install.sh from assets/airxlogoWhite.svg.

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

logo_image = Image("logo.png");
logo_x = (screen_width - logo_image.GetWidth()) / 2;
logo_y = (screen_height - logo_image.GetHeight()) / 2 - 70;

logo.sprite = Sprite(logo_image);
logo.sprite.SetX(Window.GetX() + logo_x);
logo.sprite.SetY(Window.GetY() + logo_y);

track_image = Image("bar_track.png");
track_x = (screen_width - track_image.GetWidth()) / 2;
track_y = logo_y + logo_image.GetHeight() + 44;

track.sprite = Sprite(track_image);
track.sprite.SetX(Window.GetX() + track_x);
track.sprite.SetY(Window.GetY() + track_y);

frames = [
	Image("bar_fill_0.png"),
	Image("bar_fill_1.png"),
	Image("bar_fill_2.png"),
	Image("bar_fill_3.png"),
	Image("bar_fill_4.png"),
	Image("bar_fill_5.png"),
	Image("bar_fill_6.png"),
	Image("bar_fill_7.png"),
	Image("bar_fill_8.png"),
	Image("bar_fill_9.png"),
	Image("bar_fill_10.png"),
	Image("bar_fill_11.png"),
	Image("bar_fill_12.png"),
	Image("bar_fill_13.png"),
	Image("bar_fill_14.png"),
	Image("bar_fill_15.png"),
	Image("bar_fill_16.png"),
	Image("bar_fill_17.png"),
	Image("bar_fill_18.png"),
	Image("bar_fill_19.png"),
	Image("bar_fill_20.png")
];

fill.sprite = Sprite(frames[0]);
fill.sprite.SetX(Window.GetX() + track_x);
fill.sprite.SetY(Window.GetY() + track_y);

fun refresh_callback()
{
	index = Math.Int(Plymouth.GetProgress() * 20);
	if (index < 0) index = 0;
	if (index > 20) index = 20;
	fill.sprite.SetImage(frames[index]);
}

Plymouth.SetRefreshFunction(refresh_callback);
