# AirXPi boot splash - logo centred, slim progress bar underneath, no text.
#
# Two things this script has to survive:
#
#  * systemd often reports progress only at the very end, so a bar driven by
#    Plymouth.GetProgress() alone sits at zero and the splash looks like a
#    still photo.  The bar therefore eases towards the real progress and keeps
#    a small "alive" floor while the boot is still at 0%.
#  * the theme must paint its own background.  Without Window.SetBackground*
#    the area outside the sprites is left to the framebuffer and the splash
#    looks half drawn on some TVs.
#
# The PNGs are generated by image/install.sh from assets/airxlogoWhite.svg.

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

Window.SetBackgroundTopColor(0.043, 0.067, 0.094);
Window.SetBackgroundBottomColor(0.063, 0.114, 0.141);

logo_image = Image("logo.png");
logo_x = (screen_width - logo_image.GetWidth()) / 2;
logo_y = (screen_height - logo_image.GetHeight()) / 2 - 46;

logo.sprite = Sprite(logo_image);
logo.sprite.SetX(Window.GetX() + logo_x);
logo.sprite.SetY(Window.GetY() + logo_y);

track_image = Image("bar_track.png");
track_x = (screen_width - track_image.GetWidth()) / 2;
track_y = logo_y + logo_image.GetHeight() + 46;

track.sprite = Sprite(track_image);
track.sprite.SetX(Window.GetX() + track_x);
track.sprite.SetY(Window.GetY() + track_y);

frames = [
	Image("bar_fill_0.png"),
	Image("bar_fill_1.png"),
	Image("bar_fill_2.png"),
	Image("bar_fill_3.png"),
	Image("bar_fill_4.png"),
	Image("bar_fill_5.png"),
	Image("bar_fill_6.png"),
	Image("bar_fill_7.png"),
	Image("bar_fill_8.png"),
	Image("bar_fill_9.png"),
	Image("bar_fill_10.png"),
	Image("bar_fill_11.png"),
	Image("bar_fill_12.png"),
	Image("bar_fill_13.png"),
	Image("bar_fill_14.png"),
	Image("bar_fill_15.png"),
	Image("bar_fill_16.png"),
	Image("bar_fill_17.png"),
	Image("bar_fill_18.png"),
	Image("bar_fill_19.png"),
	Image("bar_fill_20.png")
];

fill.sprite = Sprite(frames[0]);
fill.sprite.SetX(Window.GetX() + track_x);
fill.sprite.SetY(Window.GetY() + track_y);

shown = 0.0;
last_index = -1;

fun refresh_callback()
{
	target = Plymouth.GetProgress();
	if (target < 0.0) target = 0.0;
	if (target > 1.0) target = 1.0;

	# never look frozen: keep a slow creep while the boot reports 0%
	if (target <= 0.0) {
		target = 0.10;
	}
	if (target < 0.985) {
		target = target + 0.004;
	}

	shown = shown + (target - shown) * 0.07;

	index = Math.Int(shown * 20);
	if (index < 0) index = 0;
	if (index > 20) index = 20;
	if (index != last_index) {
		fill.sprite.SetImage(frames[index]);
		last_index = index;
	}
}

Plymouth.SetRefreshFunction(refresh_callback);
