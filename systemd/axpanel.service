[Unit]
Description=AirXPi web panel (AirPlay, VPN exit, Wi-Fi)
Documentation=https://github.com/haboshehry/airxpi
After=axnet.service axplay.service vpnexit-web.service
Wants=axnet.service axplay.service
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/airxpi/lib
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m airxpi.axpanel
Restart=always
RestartSec=3
# port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
