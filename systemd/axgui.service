[Unit]
Description=AirXPi HDMI user interface (now playing + settings)
Documentation=https://github.com/haboshehry/airxpi
After=axpanel.service systemd-user-sessions.service
Wants=axpanel.service
Conflicts=getty@tty1.service

[Service]
Type=simple
Environment=HOME=/root
Environment=PYTHONPATH=/opt/airxpi/lib
Environment=XDG_RUNTIME_DIR=/run/airxpi
Environment=DISPLAY=:0
Environment=QT_LOGGING_RULES=qt.qpa.*=false
# No Qt scale factor here.  With no window manager, Qt5 applies the factor to
# the geometry it asks for but not to the surface X hands back, so a
# full-screen window ends up painting 1280x720 into the top-left corner of a
# 1920x1080 screen.  app.py measures the real screen and scales its own fonts
# and paddings instead, which works for both 720p and 1080p panels.
Environment=QT_AUTO_SCREEN_SCALE_FACTOR=0
Environment=QT_FONT_DPI=96
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
ExecStart=/usr/bin/xinit /opt/airxpi/bin/axgui-client -- /usr/bin/X :0 vt1 -keeptty -nolisten tcp -novtswitch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
