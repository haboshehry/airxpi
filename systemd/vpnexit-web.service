[Unit]
Description=vpnexit API (VPN exit switcher, localhost only)
After=network-online.target strongswan-starter.service
Wants=network-online.target strongswan-starter.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/vpnexit serve 8088
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
